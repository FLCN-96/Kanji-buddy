# Local deck source artifacts — never needed in the repo, the bundled
# data/cards.json is what the app reads at runtime.
uploads/

# Scratch / handoff artifacts
tmp/
Kanji-buddy-handoff.zip

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# JMdict source cache for the kanji-words generator (regenerate from tools/build-kanji-words.py)
tools/cache/

# Python bytecode cache (created when running tools/*.py)
__pycache__/
*.pyc

# Agent / local assistant state (never commit — contains host-specific paths)
.claude/
